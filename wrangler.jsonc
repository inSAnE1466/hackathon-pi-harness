{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claims-harness",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session",
      },
    ],
  },
  "exports": {
    "Session": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
